# Python/cache noise
__pycache__/
*.pyc

# Logs
*.log
nohup.out

# Pipeline outputs
/telomere_outputs/
/output/
/outputs/
/results/
/tmp/

# Common generated analysis directories (when outputs are created inside repo)
**/reads/
**/plots/
**/raw_reads/
**/trimmed/
**/trimming_reports/

# Common generated analysis files
**/telomere.tsv
**/genome_telomere_unit.tsv
**/*.norm
**/*.norm.tsv
**/*.png
**/*.fa
**/*.fq


# Config manifests — ignore everything except the bundled examples
telomere/config/*.tsv
!telomere/config/manifest.example.tsv
!telomere/config/order.tsv

# Speficic Tyler-isms
run_all.sh
telomere_update-todo.txt
run_aviti.sh
